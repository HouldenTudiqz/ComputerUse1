{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Perception Data",
  "description": "A schema for the data extracted from a web page by the Perception module.",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    },
    "interactive_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": ["tag", "selector"]
      }
    },
    "content_summary": {
      "type": "string"
    }
  },
  "required": ["url", "title", "interactive_elements", "content_summary"]
}
