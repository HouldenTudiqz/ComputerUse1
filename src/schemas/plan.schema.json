{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Action Plan",
  "description": "A schema for a plan of actions to be executed by the Navigator.",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["click", "type", "navigate"]
          },
          "selector": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["type"]
      }
    }
  },
  "required": ["actions"]
}
